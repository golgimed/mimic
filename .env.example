# Copy to .env to override defaults

PORT=3000
LOG_LEVEL=info
SCHEDULER_INTERVAL_MS=1000

# Comma-separated list of provider names to enable. Omit to enable all registered providers.
# MIMIC_PROVIDERS=zenvia,integraicp

DB_PATH=db/simulator.sqlite

DEFAULT_DELAY_MS=0
ZENVIA_STATUS_DELAY_MS=2000

# Default persistence setting for CRUD-shaped OpenAPI-mocked routes.
# Override per spec with x-mimic-persist. See specs/README.md.
MIMIC_OPENAPI_PERSIST=false

# Where the bry-scad provider's test-only POST /coletas/{chave}/concluir
# callback delivers the completion webhook — the real BRy SCAD API has no
# such endpoint; this simulates a participant finishing signing so an E2E
# test can drive a collection to CONCLUIDO. Empty disables the callback.
BRY_SCAD_WEBHOOK_URL=http://golgimed-server:8080/v1/webhooks/signatures/bry
